{{> header}}

<div id="contents">

    <div id="adbox">

        <img src="/images/sea-sound.jpg" alt="Img">

        <h1>Enjoy the Summer with Us!</h1>

        <p>
            This website template has been designed by
            <a href="http://www.freewebsitetemplates.com/">
                Free Website Templates
            </a>
            for you, for free.
        </p>

    </div>

    <div id="main">

        <div class="box">

            <div>

                <div>

                    <h3>Featured Trips</h3>

                    <ul>

                        {{#each trips}}

                        <li>

                            <h4>{{this.name}}</h4>

                            <p>Length: {{this.length}}</p>

                            <p>Price: {{this.price}}</p>

                        </li>

                        {{/each}}

                    </ul>

                </div>

            </div>

        </div>

        <div id="testimonials" class="box">

            <div>

                <div>

                    <h3>Testimonials</h3>

                    <p>
                        “In hac habitasse platea dictumst.”
                        <span>- Travlr Guest</span>
                    </p>

                </div>

            </div>

        </div>

    </div>

    <div id="sidebar">

        <div class="section">
            <a href="/rooms">
                <img src="/images/rooms.png" alt="Img">
            </a>
        </div>

        <div class="section">
            <a href="/travel">
                <img src="/images/dive-site.png" alt="Img">
            </a>
        </div>

        <div class="section">
            <a href="/meals">
                <img src="/images/food.png" alt="Img">
            </a>
        </div>

    </div>

</div>

{{> footer}}